<svg xmlns="http://www.w3.org/2000/svg" xmlns:gpa="https://www.gtk.org/grappa" width="16" height="16" viewBox="0 0 16 16" gpa:version="1" gpa:rendering="svg" gpa:state-names="north northeast east southeast south southwest west northwest" gpa:state="0" gpa:keywords="loading spinner celestial star orbit">
  <!-- A high-contrast, stationary track remains visible when motion is paused. -->
  <circle id='orbit-track' cx='8' cy='8' r='5.5' fill='none' stroke='rgb(0,0,0)' class='foreground-stroke transparent-fill' gpa:fill='none' gpa:stroke='foreground' stroke-width='1.15' stroke-opacity='0.7' gpa:states='all' gpa:stroke-minwidth='25%' gpa:stroke-maxwidth='150%' gpa:transition-type='animate' gpa:transition-duration='400ms' gpa:transition-easing='ease-in-out'/>
  <!-- The star is deliberately large enough to read at icon size. -->
  <path id="star" d="M 8 4.5 C 8.4 6.35 9.05 7.05 10.9 7.5 C 9.05 7.95 8.4 8.7 8 10.55 C 7.6 8.7 6.95 7.95 5.1 7.5 C 6.95 7.05 7.6 6.35 8 4.5 Z" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="all"/>
  <!-- Continuous animation is independent of state changes. -->
  <path id="comet" d="M 8 2.5 A 5.5 5.5 0 1 1 7.999 2.5" fill="none" stroke="rgb(0,0,0)" class="foreground-stroke transparent-fill" gpa:fill="none" gpa:stroke="foreground" stroke-width="1.65" stroke-linecap="round" gpa:states="all" gpa:animation-type="automatic" gpa:animation-direction="segment" gpa:animation-segment="0.22" gpa:animation-duration="1400ms" gpa:animation-repeat="indefinite" gpa:animation-easing="linear" gpa:stroke-minwidth='25%' gpa:stroke-maxwidth='150%' gpa:transition-type='animate' gpa:transition-duration='400ms' gpa:transition-easing='ease-in-out'/>
  <!-- Eight hand-placed phase markers; the host can advance states if desired. -->
  <circle id="phase-north" cx="8" cy="2.5" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="north" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
  <circle id="phase-northeast" cx="11.89" cy="4.11" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="northeast" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
  <circle id="phase-east" cx="13.5" cy="8" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="east" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
  <circle id="phase-southeast" cx="11.89" cy="11.89" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="southeast" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
  <circle id="phase-south" cx="8" cy="13.5" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="south" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
  <circle id="phase-southwest" cx="4.11" cy="11.89" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="southwest" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
  <circle id="phase-west" cx="2.5" cy="8" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="west" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
  <circle id="phase-northwest" cx="4.11" cy="4.11" r="1.2" fill="rgb(0,0,0)" stroke="none" class="foreground-fill" gpa:fill="foreground" gpa:stroke="none" gpa:states="northwest" gpa:transition-type="fade" gpa:transition-duration="140ms"/>
</svg>