<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkBox" id="root_box">
    <property name="orientation">vertical</property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <child>
      <object class="GtkStack" id="sidebar_stack">
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">150</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>

        <!-- Empty State in Left Sidebar -->
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <property name="vexpand">true</property>
                <property name="margin-start">20</property>
                <property name="margin-end">20</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">boxxy-user-bookmarks-symbolic</property>
                    <property name="pixel-size">48</property>
                    <property name="margin-bottom">4</property>
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">No Bookmarks Yet</property>
                    <property name="justify">center</property>
                    <property name="wrap">true</property>
                    <style>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Save Bash or Python scripts with {{{variable}}} placeholders for one-click execution in your active terminal.</property>
                    <property name="justify">center</property>
                    <property name="wrap">true</property>
                    <style>
                      <class name="caption"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="halign">center</property>
                    <property name="margin-top">8</property>
                    <child>
                      <object class="GtkButton" id="empty_open_tab_btn">
                        <property name="halign">center</property>
                        <style>
                          <class name="suggested-action"/>
                          <class name="pill"/>
                        </style>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">boxxy-user-bookmarks-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Open Bookmarks Tab</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="empty_new_btn">
                        <property name="halign">center</property>
                        <style>
                          <class name="flat"/>
                        </style>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">boxxy-plus-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">New Bookmark</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

        <!-- Populated List Page in Left Sidebar -->
        <child>
          <object class="GtkStackPage">
            <property name="name">list</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">true</property>
                    <property name="hscrollbar-policy">never</property>
                    <child>
                      <object class="GtkListBox" id="list_box">
                        <property name="selection-mode">none</property>
                        <property name="margin-top">6</property>
                        <property name="margin-bottom">6</property>
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <style>
                          <class name="navigation-sidebar"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator">
                    <property name="orientation">horizontal</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <child>
                      <object class="GtkButton" id="footer_open_tab_btn">
                        <property name="hexpand">true</property>
                        <property name="tooltip-text">Open Bookmarks Tab to manage and edit scripts</property>
                        <style>
                          <class name="flat"/>
                        </style>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">boxxy-external-link-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Open Bookmarks Tab</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="footer_new_btn">
                        <property name="icon-name">boxxy-plus-symbolic</property>
                        <property name="tooltip-text">Create New Bookmark</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
