<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwDialog" id="whats_new_dialog">
    <property name="title">What's New in Boxxy</property>
    <property name="content-width">700</property>
    <property name="default-widget">read_btn</property>
    <property name="focus-widget">close_btn</property>
    <child>
      <object class="GtkStack" id="commits_stack">
        <property name="transition-type">slide-left-right</property>
        <property name="transition-duration">200</property>
        <property name="vhomogeneous">false</property>
        <property name="interpolate-size">true</property>

        <!-- Page 1: Main What's New Overview -->
        <child>
          <object class="GtkStackPage">
            <property name="name">list</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>

                <!-- Compact Hero Banner: Text is main child (controls height), Character is overlay on right -->
                <child>
                  <object class="GtkOverlay" id="hero_overlay">
                    <style>
                      <class name="whats-new-hero"/>
                    </style>
                    <property name="height-request">200</property>
                    <property name="overflow">hidden</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <property name="halign">fill</property>
                        <property name="valign">center</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">165</property>
                        <property name="margin-top">14</property>
                        <property name="margin-bottom">14</property>
                        <child>
                          <object class="GtkLabel" id="hero_badge_label">
                            <property name="label">✨ FRESH UPDATE</property>
                            <property name="halign">start</property>
                            <style>
                              <class name="whats-new-badge"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="hero_title_label">
                            <property name="label">Boxxy Leveled Up!</property>
                            <property name="halign">start</property>
                            <property name="wrap">true</property>
                            <property name="xalign">0</property>
                            <property name="margin-top">2</property>
                            <property name="margin-bottom">2</property>
                            <style>
                              <class name="title-2"/>
                              <class name="whats-new-hero-title"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStack" id="commit_range_stack">
                            <property name="transition-type">crossfade</property>
                            <property name="transition-duration">150</property>
                            <property name="vhomogeneous">false</property>
                            <property name="hhomogeneous">false</property>
                            <property name="halign">start</property>
                            <property name="margin-top">20</property>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">display</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">6</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkLabel" id="commit_pill_label">
                                        <property name="label">a1b2c3d → e4f5g6h</property>
                                        <property name="halign">start</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="monospace"/>
                                          <class name="whats-new-commit-pill"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="edit_range_btn">
                                        <property name="icon-name">boxxy-document-edit-symbolic</property>
                                        <property name="tooltip-text">Customize commit range</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="flat"/>
                                          <class name="whats-new-range-btn"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkStackPage">
                                <property name="name">edit</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">6</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkEntry" id="from_commit_entry">
                                        <property name="width-chars">9</property>
                                        <property name="max-width-chars">12</property>
                                        <property name="placeholder-text">from</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="monospace"/>
                                          <class name="whats-new-range-entry"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label">→</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkEntry" id="to_commit_entry">
                                        <property name="width-chars">9</property>
                                        <property name="max-width-chars">12</property>
                                        <property name="placeholder-text">to</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="monospace"/>
                                          <class name="whats-new-range-entry"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="refresh_range_btn">
                                        <property name="icon-name">view-refresh-symbolic</property>
                                        <property name="tooltip-text">Fetch commits for this range</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="suggested-action"/>
                                          <class name="whats-new-range-btn"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="hero_subtitle_label">
                            <property name="label">Hot out of the compiler and ready to roll.</property>
                            <property name="halign">start</property>
                            <property name="wrap">true</property>
                            <property name="max-width-chars">28</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="overlay">
                      <object class="GtkPicture" id="banner_picture">
                        <property name="content-fit">contain</property>
                        <property name="halign">end</property>
                        <property name="valign">fill</property>
                        <property name="can-shrink">true</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">4</property>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Main Body Content -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">14</property>
                    <property name="margin-start">20</property>
                    <property name="margin-end">20</property>
                    <property name="margin-top">16</property>
                    <property name="margin-bottom">20</property>

                    <!-- Stats and Commits Section (no outer border box) -->
                    <child>
                      <object class="GtkBox" id="stats_card">
                        <property name="orientation">vertical</property>
                        <property name="spacing">14</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="homogeneous">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <style>
                                  <class name="whats-new-stat-tile"/>
                                </style>
                                <child>
                                  <object class="GtkLabel" id="commits_val">
                                    <property name="label">📦 0</property>
                                    <style>
                                      <class name="whats-new-stat-big"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="commits_caption">
                                    <property name="label">Commits Shipped</property>
                                    <style>
                                      <class name="whats-new-stat-sub"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <style>
                                  <class name="whats-new-stat-tile"/>
                                </style>
                                <child>
                                  <object class="GtkLabel" id="files_val">
                                    <property name="label">🗂️ 0</property>
                                    <style>
                                      <class name="whats-new-stat-big"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="files_caption">
                                    <property name="label">Files Touched</property>
                                    <style>
                                      <class name="whats-new-stat-sub"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <style>
                                  <class name="whats-new-stat-tile"/>
                                </style>
                                <child>
                                  <object class="GtkLabel" id="lines_val">
                                    <property name="label">+0 / -0</property>
                                    <property name="use-markup">true</property>
                                    <style>
                                      <class name="whats-new-stat-big"/>
                                      <class name="monospace"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="lines_caption">
                                    <property name="label">Lines of Code</property>
                                    <style>
                                      <class name="whats-new-stat-sub"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <style>
                                  <class name="whats-new-stat-tile"/>
                                </style>
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">6</property>
                                    <property name="halign">center</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkBox" id="contributors_avatars_box">
                                        <property name="orientation">horizontal</property>
                                        <property name="spacing">3</property>
                                        <property name="valign">center</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="contributors_val">
                                        <property name="label">1</property>
                                        <style>
                                          <class name="whats-new-stat-big"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="contributors_caption">
                                    <property name="label">Contributors</property>
                                    <property name="use-markup">true</property>
                                    <property name="halign">center</property>
                                    <style>
                                      <class name="whats-new-stat-sub"/>
                                      <class name="boxxy-link"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox" id="commits_box">
                            <property name="orientation">vertical</property>
                            <property name="spacing">8</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">8</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">COMMITS IN THIS UPDATE</property>
                                    <property name="halign">start</property>
                                    <property name="valign">center</property>
                                    <property name="hexpand">true</property>
                                    <style>
                                      <class name="whats-new-commits-header"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="see_diff_label">
                                    <property name="use-markup">true</property>
                                    <property name="halign">end</property>
                                    <property name="valign">center</property>
                                    <style>
                                      <class name="whats-new-see-diff"/>
                                      <class name="boxxy-link"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow" id="commits_scrolled">
                                <property name="hscrollbar-policy">never</property>
                                <property name="vscrollbar-policy">automatic</property>
                                <property name="propagate-natural-height">true</property>
                                <property name="max-content-height">220</property>
                                <property name="vexpand">true</property>
                                <child>
                                  <object class="GtkBox" id="commits_list">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">4</property>
                                    <property name="valign">start</property>
                                    <property name="margin-end">10</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Bottom Action Bar: Ask Another AI on left, Close + Read What's New on right -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="GtkButton" id="copy_prompt_btn">
                            <property name="halign">start</property>
                            <property name="tooltip-text">Copy the update changelog prompt to paste in any web AI</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage" id="copy_prompt_icon">
                                    <property name="icon-name">boxxy-edit-copy-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Ask Another AI</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">8</property>
                            <property name="hexpand">true</property>
                            <property name="halign">end</property>
                            <child>
                              <object class="GtkButton" id="close_btn">
                                <property name="label">Close</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="read_btn">
                                <child>
                                  <object class="GtkBox">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">8</property>
                                    <property name="halign">center</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">boxxy-boxxyclaw-symbolic</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label">Read What's New</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <style>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

        <!-- Page 2: Full-Dialog Commit Message Reader -->
        <child>
          <object class="GtkStackPage">
            <property name="name">detail</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">20</property>
                    <property name="margin-end">20</property>
                    <property name="margin-top">16</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkButton" id="commit_back_btn">
                        <property name="label">← Back</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <style>
                          <class name="flat"/>
                          <class name="whats-new-back-btn"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="detail_sha_label">
                        <property name="use-markup">true</property>
                        <property name="halign">end</property>
                        <property name="valign">center</property>
                        <property name="hexpand">true</property>
                        <style>
                          <class name="whats-new-see-diff"/>
                          <class name="boxxy-link"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator">
                    <property name="orientation">horizontal</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="detail_scrolled">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <property name="min-content-height">440</property>
                    <property name="vexpand">true</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkLabel" id="detail_message_label">
                        <property name="use-markup">true</property>
                        <property name="wrap">true</property>
                        <property name="wrap-mode">word-char</property>
                        <property name="xalign">0</property>
                        <property name="yalign">0</property>
                        <property name="selectable">true</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="margin-top">18</property>
                        <property name="margin-bottom">24</property>
                        <style>
                          <class name="whats-new-commit-detail-text"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
