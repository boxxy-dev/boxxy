<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="AdwDialog" id="welcome_dialog">
    <property name="name">welcome_dialog</property>
    <property name="title">Welcome to Boxxy</property>
    <property name="presentation-mode">floating</property>
    <property name="can-close">true</property>
    <property name="content-width">840</property>
    <property name="content-height">630</property>
    <property name="default-widget">lets_go_btn</property>
    <property name="focus-widget">lets_go_btn</property>
    <style>
      <class name="welcome-dialog"/>
    </style>
    <child>
      <object class="GtkOverlay" id="welcome_stage">
        <property name="overflow">hidden</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <style>
          <class name="welcome-stage"/>
        </style>
        <child>
          <object class="GtkPicture" id="video_picture">
            <property name="content-fit">cover</property>
            <property name="can-shrink">true</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <property name="halign">fill</property>
            <property name="valign">fill</property>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="halign">end</property>
            <property name="valign">end</property>
            <property name="margin-end">22</property>
            <property name="margin-bottom">18</property>
            <style>
              <class name="welcome-actions"/>
            </style>
            <child>
              <object class="GtkButton" id="play_again_btn">
                <property name="focus-on-click">false</property>
                <style>
                  <class name="pill"/>
                  <class name="welcome-replay-btn"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">view-refresh-symbolic</property>
                        <property name="pixel-size">14</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Play again</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="lets_go_btn">
                <property name="label">Let's Go</property>
                <style>
                  <class name="suggested-action"/>
                  <class name="pill"/>
                  <class name="welcome-go-btn"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
