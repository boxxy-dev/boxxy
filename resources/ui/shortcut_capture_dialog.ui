<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.4"/>
  <object class="AdwDialog" id="capture_dialog">
    <property name="title" translatable="yes">Set Shortcut</property>
    <property name="content-width">430</property>
    <property name="follows-content-size">True</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-start-title-buttons">False</property>
            <property name="show-end-title-buttons">True</property>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">14</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">18</property>
            <property name="margin-start">20</property>
            <property name="margin-end">20</property>

            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <child>
                  <object class="GtkLabel" id="action_title_label">
                    <property name="halign">center</property>
                    <style>
                      <class name="title-3"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="default_hint_label">
                    <property name="halign">center</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="capture_zone">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="valign">center</property>
                <style>
                  <class name="card"/>
                  <class name="shortcut-capture-card"/>
                </style>
                <child>
                  <object class="GtkBox" id="preview_slot">
                    <property name="orientation">horizontal</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="spacing">8</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="prompt_label">
                    <property name="label" translatable="yes">Press a key combination, Backspace to disable, or Esc to cancel</property>
                    <property name="halign">center</property>
                    <property name="justify">center</property>
                    <property name="wrap">True</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="existing_section">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="visible">False</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Assigned Shortcuts</property>
                    <property name="halign">start</property>
                    <style>
                      <class name="caption-heading"/>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwWrapBox" id="existing_chips_wrap">
                    <property name="child-spacing">6</property>
                    <property name="line-spacing">6</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="performable_row">
                <property name="orientation">horizontal</property>
                <property name="spacing">10</property>
                <property name="visible">False</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Pass key to terminal when inactive (Smart Shortcut)</property>
                    <property name="hexpand">True</property>
                    <property name="halign">start</property>
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <style>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkSwitch" id="performable_switch">
                    <property name="valign">center</property>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox" id="conflict_card">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="visible">False</property>
                <style>
                  <class name="shortcut-conflict-banner"/>
                </style>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">boxxy-vibe-symbolic</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="conflict_label">
                    <property name="hexpand">True</property>
                    <property name="halign">start</property>
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <style>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">8</property>
                <property name="margin-top">4</property>
                <child>
                  <object class="GtkButton" id="disable_btn">
                    <property name="label" translatable="yes">Disable</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="reset_default_btn">
                    <property name="label" translatable="yes">Default</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="hexpand">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="add_secondary_btn">
                    <property name="label" translatable="yes">Add</property>
                    <property name="visible">False</property>
                    <property name="tooltip-text" translatable="yes">Keep current shortcut and add this as an additional trigger</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="save_btn">
                    <property name="label" translatable="yes">Set Shortcut</property>
                    <property name="sensitive">False</property>
                    <style>
                      <class name="suggested-action"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
