<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwDialog" id="boxxy_news_dialog">
    <property name="title">Boxxy News</property>
    <property name="content-width">680</property>
    <property name="follows-content-size">true</property>
    <property name="focus-widget">close_btn</property>
    <child>
      <object class="GtkStack" id="news_stack">
        <property name="width-request">680</property>
        <property name="transition-type">slide-left-right</property>
        <property name="transition-duration">200</property>
        <property name="vhomogeneous">false</property>
        <property name="interpolate-size">true</property>

        <!-- Page 1: News Archive List -->
        <child>
          <object class="GtkStackPage">
            <property name="name">list</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>

                <!-- Compact Hero Strip -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">12</property>
                    <style>
                      <class name="whats-new-hero"/>
                    </style>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <property name="hexpand">true</property>
                        <property name="valign">center</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">18</property>
                        <property name="margin-bottom">18</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">5</property>
                            <property name="halign">start</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="whats-new-badge"/>
                            </style>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">boxxy-up-arrow-in-a-star-symbolic</property>
                                <property name="pixel-size">12</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">BOXXY BROADCASTS</property>
                                <property name="valign">center</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Boxxy News</property>
                            <property name="halign">start</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="title-2"/>
                              <class name="whats-new-hero-title"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="news_status_label">
                            <property name="label">Release highlights, feature announcements, and community updates.</property>
                            <property name="halign">start</property>
                            <property name="wrap">true</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="dim-label"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="news_refresh_btn">
                        <property name="icon-name">view-refresh-symbolic</property>
                        <property name="tooltip-text">Refresh announcements</property>
                        <property name="valign">center</property>
                        <property name="margin-end">20</property>
                        <property name="focus-on-click">false</property>
                        <style>
                          <class name="flat"/>
                          <class name="circular"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>

                <!-- Body Area -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">14</property>
                    <property name="margin-start">20</property>
                    <property name="margin-end">20</property>
                    <property name="margin-top">16</property>
                    <property name="margin-bottom">18</property>

                    <child>
                      <object class="GtkStack" id="list_state_stack">
                        <property name="transition-type">crossfade</property>
                        <property name="transition-duration">160</property>
                        <property name="vhomogeneous">false</property>
                        <property name="interpolate-size">true</property>

                        <child>
                          <object class="GtkStackPage">
                            <property name="name">loading</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                                <property name="halign">center</property>
                                <property name="valign">center</property>
                                <property name="height-request">220</property>
                                <child>
                                  <object class="GtkSpinner">
                                    <property name="spinning">true</property>
                                    <property name="width-request">30</property>
                                    <property name="height-request">30</property>
                                    <property name="halign">center</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Checking for announcements…</property>
                                    <property name="halign">center</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>

                        <child>
                          <object class="GtkStackPage">
                            <property name="name">empty</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">10</property>
                                <property name="halign">center</property>
                                <property name="valign">center</property>
                                <property name="height-request">220</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">boxxy-globe-symbolic</property>
                                    <property name="pixel-size">42</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">No Announcements Yet</property>
                                    <style>
                                      <class name="title-4"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="empty_subtitle_label">
                                    <property name="label">New release highlights and community updates will appear here.</property>
                                    <property name="justify">center</property>
                                    <property name="wrap">true</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>

                        <child>
                          <object class="GtkStackPage">
                            <property name="name">content</property>
                            <property name="child">
                              <object class="GtkScrolledWindow" id="news_scrolled">
                                <property name="hscrollbar-policy">never</property>
                                <property name="vscrollbar-policy">automatic</property>
                                <property name="propagate-natural-height">true</property>
                                <property name="max-content-height">480</property>
                                <child>
                                  <object class="GtkBox" id="news_list">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="valign">start</property>
                                    <property name="margin-top">2</property>
                                    <property name="margin-bottom">4</property>
                                    <property name="margin-end">3</property>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>

                    <!-- Bottom Action Row -->
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="margin-top">4</property>
                        <child>
                          <object class="GtkButton" id="open_web_archive_btn">
                            <property name="halign">start</property>
                            <property name="focus-on-click">false</property>
                            <property name="tooltip-text">Browse all announcements on boxxy.dev/news</property>
                            <style>
                              <class name="flat"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">boxxy-external-link-symbolic</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">View all news on boxxy.dev</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="hexpand">true</property>
                            <property name="halign">end</property>
                            <child>
                              <object class="GtkButton" id="close_btn">
                                <property name="label">Close</property>
                                <style>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

        <!-- Page 2: Article Reader -->
        <child>
          <object class="GtkStackPage">
            <property name="name">detail</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
                <property name="hexpand">true</property>

                <!-- Top Navigation Bar -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">20</property>
                    <property name="margin-end">20</property>
                    <property name="margin-top">14</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkButton" id="detail_back_btn">
                        <property name="label">← Latest News</property>
                        <property name="halign">start</property>
                        <property name="valign">center</property>
                        <property name="focus-on-click">false</property>
                        <style>
                          <class name="flat"/>
                          <class name="whats-new-back-btn"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">4</property>
                        <property name="halign">end</property>
                        <property name="valign">center</property>
                        <property name="hexpand">true</property>
                        <child>
                          <object class="GtkButton" id="detail_prev_btn">
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="tooltip-text">Newer announcement</property>
                            <property name="valign">center</property>
                            <property name="focus-on-click">false</property>
                            <style>
                              <class name="flat"/>
                              <class name="whats-new-nav-btn"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="detail_next_btn">
                            <property name="icon-name">go-next-symbolic</property>
                            <property name="tooltip-text">Older announcement</property>
                            <property name="valign">center</property>
                            <property name="focus-on-click">false</property>
                            <style>
                              <class name="flat"/>
                              <class name="whats-new-nav-btn"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkSeparator">
                    <property name="orientation">horizontal</property>
                  </object>
                </child>

                <!-- Article Body Scroller -->
                <child>
                  <object class="GtkScrolledWindow" id="detail_scrolled">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <property name="min-content-height">380</property>
                    <property name="max-content-height">480</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">10</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="margin-top">18</property>
                        <property name="margin-bottom">22</property>

                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkLabel" id="detail_category_badge">
                                <property name="label">NEWS</property>
                                <property name="valign">center</property>
                                <style>
                                  <class name="boxxy-news-cat-pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="detail_date_label">
                                <property name="label"></property>
                                <property name="valign">center</property>
                                <style>
                                  <class name="dim-label"/>
                                  <class name="caption"/>
                                  <class name="monospace"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkLabel" id="detail_title_label">
                            <property name="wrap">true</property>
                            <property name="wrap-mode">word-char</property>
                            <property name="xalign">0</property>
                            <property name="selectable">true</property>
                            <style>
                              <class name="title-2"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="GtkLabel" id="detail_summary_label">
                            <property name="wrap">true</property>
                            <property name="wrap-mode">word-char</property>
                            <property name="xalign">0</property>
                            <property name="selectable">true</property>
                            <style>
                              <class name="dim-label"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="GtkSeparator">
                            <property name="orientation">horizontal</property>
                            <property name="margin-top">4</property>
                            <property name="margin-bottom">4</property>
                          </object>
                        </child>

                        <child>
                          <object class="GtkBox" id="detail_viewer_slot">
                            <property name="orientation">vertical</property>
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkSeparator">
                    <property name="orientation">horizontal</property>
                  </object>
                </child>

                <!-- Detail Footer -->
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <property name="margin-start">20</property>
                    <property name="margin-end">20</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">16</property>
                    <child>
                      <object class="GtkButton" id="detail_open_web_btn">
                        <property name="halign">start</property>
                        <property name="focus-on-click">false</property>
                        <property name="tooltip-text">Read this announcement on boxxy.dev</property>
                        <style>
                          <class name="flat"/>
                        </style>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <child>
                              <object class="GtkImage">
                                <property name="icon-name">boxxy-external-link-symbolic</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Open on boxxy.dev</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="hexpand">true</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkButton" id="detail_bottom_close_btn">
                            <property name="label">Close</property>
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="detail_cta_btn">
                            <property name="visible">false</property>
                            <style>
                              <class name="suggested-action"/>
                              <class name="pill"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">horizontal</property>
                                <property name="spacing">6</property>
                                <property name="halign">center</property>
                                <child>
                                  <object class="GtkLabel" id="detail_cta_label">
                                    <property name="label">Open Link</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkImage">
                                    <property name="icon-name">boxxy-external-link-symbolic</property>
                                    <property name="pixel-size">13</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
